{
    "name": "release-notes",
    "version": "2.0.0",
    "private": true,
    "description": "GitHub action for generating release notes",
    "main": "lib/main.js",
    "scripts": {
        "build": "tsc",
        "prettier": "prettier --write **/*.{js,json,md,ts,yml}",
        "lint": "eslint src --fix",
        "package": "ncc build src/main.ts --source-map --license licenses.txt --transpile-only",
        "test": "jest",
        "all": "npm run build && npm run prettier && npm run lint && npm run package && npm test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/actions/create-release-notes.git"
    },
    "keywords": [
        "release",
        "notes"
    ],
    "author": "Johny Herangi",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/openmrs/openmrs-contrib-create-release-notes/issues"
    },
    "homepage": "https://github.com/openmrs/openmrs-contrib-create-release-notes#readme",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@actions/core": "^2.0.3",
        "@actions/github": "^8.0.1"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.12.3",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "@vercel/ncc": "^0.38.4",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "jest": "^30.4.1",
        "prettier": "^3.8.3",
        "ts-jest": "^29.4.9",
        "typescript": "^5.9.3"
    }
}
